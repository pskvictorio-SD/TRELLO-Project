# --- Base de datos -----------------------------------------------------------
# En desarrollo, un MySQL local:
#   DB_HOST=localhost  DB_PORT=3306  DB_SSL=false
# En produccion, TiDB Cloud (compatible con el protocolo MySQL):
#   DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com  DB_PORT=4000  DB_SSL=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario
DB_PASSWORD=tu_contrasena
DB_NAME=tu_equipo
DB_SSL=false
# Bajo a proposito: en serverless se multiplican las instancias, no las
# consultas dentro de una.
DB_MAX_CONEXIONES=4

# --- Autenticacion -----------------------------------------------------------
JWT_SECRET=una_cadena_larga_y_aleatoria
JWT_EXPIRES=7d

# --- CORS --------------------------------------------------------------------
# Origenes permitidos ademas de http://localhost:5173, separados por coma.
CORS_ORIGENES=https://tu-frontend.vercel.app

# --- Solo desarrollo ---------------------------------------------------------
PORT=3000
